{
  "expo": {
    "name": "VoronoiMobile",
    "slug": "voronoi-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "voronoi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
